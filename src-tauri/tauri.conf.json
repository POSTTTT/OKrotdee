{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OKrotdee",
  "version": "0.1.0",
  "identifier": "com.okrotdee.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "O.K.รถดี",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMDFCRTJBNUIwQURFNTMKUldSVDNncGJLcjRCYm1XamNCeEtlU0c5YlFMMkZNRFkxcHlBa1ZJcmZsSy9JWkc4MkpvRHhvQzUK",
      "endpoints": [
        "https://github.com/POSTTTT/OKrotdee/releases/latest/download/latest.json"
      ]
    }
  }
}
