{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/datadir.txt" },
        { "path": "$APPCONFIG/okrotdee.db" },
        { "path": "$APPCONFIG/okrotdee.db-wal" },
        { "path": "$APPCONFIG/okrotdee.db-shm" },
        { "path": "$APPCONFIG/backups" },
        { "path": "$APPCONFIG/backups/**" }
      ]
    },
    "dialog:allow-save",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPCONFIG/backups" },
        { "path": "$APPCONFIG/backups/**" }
      ]
    }
  ]
}
